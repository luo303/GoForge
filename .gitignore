# --- secrets / local config ---
# 任意层级的 .env 与变体都不入库，只保留模板
.env
.env.*
!.env.example
*.pem

# --- build output ---
/backend/bin/
/backend/tmp/
# 上传的原始文档（内容寻址落盘，不入库）
/backend/storage/
# go build ./cmd/server 不带 -o 时会把二进制写到当前目录
/backend/server
/frontend/dist/
coverage.out
coverage.html
*.test

# --- frontend（启用构建链后生效） ---
/frontend/node_modules/

# --- Go work files (local tooling only) ---
go.work
go.work.sum
.vscode/
.idea/

# --- OS noise ---
.DS_Store
Thumbs.db

# --- docker local volumes (if ever bind-mounted locally) ---
deployments/.data/

# --- local scratch (local postgres data, downloaded debs, logs) ---
/.tmp/
/server.out
