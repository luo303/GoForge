# ============================================================================
# GoForge 本地开发配置模板
#
# 用法：cp .env.example .env，然后按需修改。.env 已被 .gitignore 忽略，
# 真实密码 / JWT 密钥永远不要提交到仓库。
#
# 优先级：进程环境变量 > .env 文件 > 代码默认值。
# 容器环境中由 compose 直接注入环境变量，此时不需要 .env。
# ============================================================================

# ---------- 应用 ----------
APP_ENV=dev                 # dev | prod
HTTP_ADDR=:8080             # HTTP 监听地址
SHUTDOWN_TIMEOUT=10s        # 优雅关闭的最长等待时间

# ---------- 日志 ----------
LOG_LEVEL=debug             # debug | info | warn | error
LOG_FORMAT=console          # console（人读）| json（机器读，生产用）

# ---------- PostgreSQL ----------
# 与 deployments/docker-compose.yml 中的服务名 / 端口保持一致
DB_HOST=localhost
DB_PORT=5432
DB_USER=goforge
DB_PASSWORD=goforge_dev_password
DB_NAME=goforge
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_PING_TIMEOUT=3s          # 启动时数据库连通性检查超时
DB_LOG_SQL=true             # 打印每条 SQL（观察 GORM 生成的 SQL 用，生产务必关闭）

# ---------- Redis（阶段四启用） ----------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20

# ---------- RabbitMQ（阶段五启用） ----------
RABBITMQ_URL=amqp://goforge:goforge_dev_password@localhost:5672/

# ---------- JWT（阶段三启用） ----------
JWT_SECRET=change-me-in-real-env
JWT_ACCESS_TTL=24h
