# ============================================================================
# MindOS 本地开发配置模板
#
# 用法：cp .env.example .env，然后按需修改。.env 已被 .gitignore 忽略，
# 真实密码与模型 API Key 永远不要提交到仓库。
#
# 优先级：进程环境变量 > .env 文件 > 代码默认值。
# 容器环境中由 compose 直接注入环境变量，此时不需要 .env。
#
# 规则：这里只列代码（或 compose）真的会读取的项。新增配置必须与读取它的
# 那次提交一起落地，不允许先摆占位项。
# ============================================================================

# ---------- 应用 ----------
APP_ENV=dev                 # dev | prod
HTTP_ADDR=:8080             # HTTP 监听地址
SHUTDOWN_TIMEOUT=10s        # 优雅关闭的最长等待时间

# ---------- 日志 ----------
LOG_LEVEL=debug             # debug | info | warn | error
LOG_FORMAT=console          # console（人读）| json（机器读，生产用）

# ---------- PostgreSQL（含 pgvector） ----------
# 与 deployments/docker-compose.yml 中的服务名 / 端口保持一致
DB_HOST=localhost
DB_PORT=5432
DB_USER=mindos
DB_PASSWORD=mindos_dev_password
DB_NAME=mindos
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_PING_TIMEOUT=3s          # 启动时数据库连通性检查超时
DB_LOG_SQL=true             # 打印每条 SQL（观察 GORM 生成的 SQL 用，生产务必关闭）

# ---------- Redis（按需启用，当前未接入） ----------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20

# ---------- RabbitMQ（compose 读取；应用在 Phase 16 接入） ----------
RABBITMQ_USER=mindos
RABBITMQ_PASSWORD=mindos_dev_password

# ---------- 原始文档存储 ----------
# minio：原文进对象存储（默认，compose 里已带服务）；local：写本地目录，仅用于无 Docker 的调试。
# 为什么默认 minio：原文是重索引/重算向量的唯一依据，不能跟着应用容器的磁盘一起消失。
STORAGE_DRIVER=minio
STORAGE_MAX_UPLOAD_BYTES=10485760   # 单次导入上限（10 MiB），服务端强制
STORAGE_DIR=./storage               # 仅 STORAGE_DRIVER=local 时使用

# MinIO / S3（STORAGE_DRIVER=minio 时必填，与 compose 中的服务保持一致）
MINIO_ENDPOINT=localhost:9000       # host:port，不带协议；https 用 MINIO_USE_SSL=true
MINIO_ACCESS_KEY=mindos             # 同时作为容器内的 MINIO_ROOT_USER
MINIO_SECRET_KEY=mindos_dev_password # 同时作为容器内的 MINIO_ROOT_PASSWORD
MINIO_BUCKET=mindos                 # 启动时自动创建，不需要手工建
MINIO_USE_SSL=false
MINIO_PORT=9000                     # compose 映射到宿主机的 S3 端口
MINIO_CONSOLE_PORT=9001             # 控制台 http://localhost:9001

# ---------- 模型（OpenAI 兼容接口；本阶段只校验，Phase 7/9 才调用） ----------
# 三个字段要么全配、要么全空；只配一半会在启动时报错
LLM_API_BASE=                 # 例如 https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=                    # 例如 gpt-4o-mini
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=              # 例如 text-embedding-3-small（向量维度固定 1536）

# ---------- Agent 预算（三重上限，缺一不允许运行） ----------
AGENT_MAX_STEPS=30            # 单次运行最大步数
AGENT_TOKEN_BUDGET=200000     # 单次运行最大 token 消耗
AGENT_RUN_TIMEOUT=5m          # 单次运行整体超时
